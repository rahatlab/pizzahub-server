PORT=5000
NODE_ENV=development

# MongoDB Atlas / local
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pizzahub?retryWrites=true&w=majority
MONGODB_DB=pizzahub

# Better Auth (Next.js project) — used for JWT issuer/audience and JWKS
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Stripe (test mode locally)
# Note: STRIPE_WEBHOOK_SECRET below is the `stripe listen` secret for local
# forwarding. Keep the dashboard-endpoint secret in your own .env only.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ImgBB
IMGBB_API_KEY=replace-me
