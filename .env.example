PORT=5000
NODE_ENV=development

# MongoDB Atlas / local
MONGODB_URI=mongodb://127.0.0.1:27017/pizzahub
MONGODB_DB=pizzahub

# Better Auth (Next.js project) — used for JWT issuer/audience and JWKS
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Stripe (test mode locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB
IMGBB_API_KEY=
